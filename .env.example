# ============================================================================
# AegisPay — PayPal AI Hackathon Environment Configuration
# Copy this file to .env (`cp .env.example .env`) or enter credentials live in the UI Vault
# ============================================================================

# Server Port
PORT=8787

# PayPal Developer Sandbox Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Primary AI Provider: Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Secondary Failover AI Provider: Groq Cloud LPU (https://console.groq.com/keys)
# Automatically activated when Gemini hits HTTP 429 rate limits or latency thresholds
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Cryptographic Kernel Secret (Used for HMAC-SHA256 Single-Use Review Tokens & Contract Signatures)
AEGIS_KERNEL_SECRET=aegispay-deterministic-kernel-hmac-v1-2026

# Optional Sponsor Integrations
ZAPIER_WEBHOOK_URL=
ELASTIC_ENDPOINT_URL=
ELASTIC_API_KEY=
