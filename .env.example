# ============================================================================
# AegisPay — PayPal AI Hackathon Environment Configuration
# Copy this file to .env (`cp .env.example .env`) or enter credentials live in the UI Vault
# ============================================================================

# Server Port
PORT=8787

# PayPal Developer Sandbox Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Note: If left blank, AegisPay automatically activates its Cryptographic Signed Sandbox Emulator
# so judges can test all 5 stages immediately with zero setup, OR you can paste live keys in the UI!
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
# Used for Multimodal Vision Defect Grading, Semantic Scam Classification, Agent Negotiation, and Empathetic Retention
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cryptographic Kernel Secret (Used for HMAC-SHA256 Single-Use Review Tokens & Contract Signatures)
AEGIS_KERNEL_SECRET=aegispay-deterministic-kernel-hmac-v1-2026

# Optional Sponsor Integrations
ZAPIER_WEBHOOK_URL=
ELASTIC_ENDPOINT_URL=
ELASTIC_API_KEY=
