{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/postman/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/extension.zip",
      "destination": "/api/index.ts"
    }
  ]
}
